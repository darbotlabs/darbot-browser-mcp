<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>DarbotLabs.Browser.MCP</PackageId>
    <Version>2.1.4</Version>
    <PackageVersion>2.1.4</PackageVersion>
    <Authors>darbotlabs</Authors>
    <Company>darbotlabs</Company>
    <Product>Darbot Browser MCP</Product>
    <Description>Darbot Browser MCP — framework of 68 AI-driven autonomous browser tools with portable session state support and VS Code GitHub Copilot agent mode integration</Description>
    <Copyright>Copyright 2026 darbotlabs</Copyright>
    <PackageProjectUrl>https://github.com/darbotlabs/darbot-browser-mcp</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>mcp browser automation playwright vscode copilot azure entra</PackageTags>
    <RepositoryUrl>https://github.com/darbotlabs/darbot-browser-mcp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="nuget\**" />
    <EmbeddedResource Remove="nuget\**" />
    <None Remove="nuget\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\README.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\integrations\vscode-extension.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\getting-started\installation.md" Pack="true" PackagePath="docs\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
