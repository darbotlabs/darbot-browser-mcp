<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>DarbotLabs.Browser.MCP</PackageId>
    <Version>0.3.0</Version>
    <Authors>DarbotLabs</Authors>
    <Company>DarbotLabs</Company>
    <Product>🤖 Darbot Browser MCP - Autonomous Browser Companion</Product>
    <Description>🤖 Your Autonomous Browser Companion - 39 AI-driven browser automation tools for Model Context Protocol (MCP) servers (34 accessibility-first + 5 vision-mode). Includes AI-native automation, autonomous crawling, work profiles, and VS Code GitHub Copilot agent mode integration with support for Local, Hosted (Docker), and Cloud (Azure) deployment modes. See docs/readme_index.md for the canonical tool list.</Description>
    <Copyright>Copyright 2025 DarbotLabs</Copyright>
    <PackageProjectUrl>https://github.com/darbotlabs/darbot-browser-mcp</PackageProjectUrl>
    <PackageIcon>icon-128.png</PackageIcon>
    <PackageLicense>Apache-2.0</PackageLicense>
    <PackageTags>mcp browser autonomous darbot testing web-automation model-context-protocol ai copilot github-copilot vscode agent-mode work-profiles azure docker msal ai-native crawling</PackageTags>
    <RepositoryUrl>https://github.com/darbotlabs/darbot-browser-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    <None Include="..\..\DarbotGuide.md" Pack="true" PackagePath="docs\"/>
    <None Include="..\..\VSCODE_INSTALLATION.md" Pack="true" PackagePath="docs\"/>
    <None Include="..\..\extension\icons\icon-128.png" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>