{
  "name": "darbot-browser-mcp",
  "displayName": "Darbot Browser MCP",
  "description": "Your autonomous browser companion for VS Code. 59 AI-driven browser tools exposed to GitHub Copilot agent mode via the Model Context Protocol, with Microsoft Edge work-profile support.",
  "version": "2.0.0",
  "publisher": "darbotlabs",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=20"
  },
  "icon": "icon.png",
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "keywords": [
    "mcp",
    "browser",
    "autonomous",
    "darbot",
    "automation",
    "testing",
    "screenshot",
    "copilot",
    "ai",
    "edge",
    "chrome",
    "web-automation",
    "playwright",
    "selenium-alternative",
    "browser-testing",
    "accessibility",
    "work-profiles",
    "session-management",
    "github-copilot",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/darbotlabs/darbot-browser-mcp.git"
  },
  "homepage": "https://github.com/darbotlabs/darbot-browser-mcp",
  "bugs": {
    "url": "https://github.com/darbotlabs/darbot-browser-mcp/issues"
  },
  "license": "Apache-2.0",
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "darbot-browser-mcp",
        "label": "Darbot Browser MCP Server"
      }
    ],
    "commands": [
      {
        "command": "darbot-browser-mcp.startServer",
        "title": "Start MCP Server",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.stopServer",
        "title": "Stop MCP Server",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.restartServer",
        "title": "Restart MCP Server",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.showStatus",
        "title": "Show Server Status",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.openBridgeStatus",
        "title": "Open Bridge Status",
        "category": "Darbot Browser MCP"
      }
    ],
    "configuration": {
      "title": "Darbot Browser MCP",
      "properties": {
        "darbot-browser-mcp.serverPath": {
          "type": "string",
          "default": "npx @darbotlabs/darbot-browser-mcp@latest",
          "description": "Path or command used to start the Browser MCP server. Whitespace-separated; the first token is the executable."
        },
        "darbot-browser-mcp.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the Browser MCP server when VS Code starts."
        },
        "darbot-browser-mcp.autoConfigureMCP": {
          "type": "boolean",
          "default": true,
          "description": "When set, the extension offers to enable VS Code's MCP Gallery (chat.mcp.gallery.enabled) the first time it activates."
        },
        "darbot-browser-mcp.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Log level forwarded to the Browser MCP server."
        },
        "darbot-browser-mcp.browser": {
          "type": "string",
          "default": "msedge",
          "enum": [
            "msedge",
            "chrome",
            "firefox",
            "webkit"
          ],
          "description": "Browser channel the MCP server should drive."
        },
        "darbot-browser-mcp.headless": {
          "type": "boolean",
          "default": false,
          "description": "Run the browser in headless mode."
        },
        "darbot-browser-mcp.noSandbox": {
          "type": "boolean",
          "default": true,
          "description": "Disable the Chromium sandbox. Required inside many containers; safe to leave enabled on the desktop."
        },
        "darbot-browser-mcp.bridgeStatusUrl": {
          "type": "string",
          "default": "http://localhost:9223/health",
          "description": "HTTP endpoint opened by the 'Open Bridge Status' command. Override when running the MCP server on a non-default port."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^11.7.1",
    "typescript": "^5.9.3"
  }
}

