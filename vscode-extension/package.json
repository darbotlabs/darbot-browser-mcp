{
  "name": "darbot-browser-mcp",
  "displayName": "Darbot Browser MCP",
  "description": "Your autonomous browser companion for VS Code. 68 AI-driven browser tools exposed to GitHub Copilot agent mode via the Model Context Protocol, with portable session-state support.",
  "version": "2.1.4",
  "publisher": "darbotlabs",
  "engines": {
    "vscode": "^1.132.0",
    "node": ">=20"
  },
  "icon": "icon.png",
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "keywords": [
    "mcp",
    "browser",
    "autonomous",
    "darbot",
    "automation",
    "testing",
    "screenshot",
    "copilot",
    "ai",
    "edge",
    "chrome",
    "web-automation",
    "playwright",
    "selenium-alternative",
    "browser-testing",
    "accessibility",
    "work-profiles",
    "session-management",
    "github-copilot",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/darbotlabs/darbot-browser-mcp.git"
  },
  "homepage": "https://github.com/darbotlabs/darbot-browser-mcp",
  "bugs": {
    "url": "https://github.com/darbotlabs/darbot-browser-mcp/issues"
  },
  "license": "Apache-2.0",
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "darbot-browser-mcp",
        "label": "Darbot Browser MCP Server"
      }
    ],
    "commands": [
      {
        "command": "darbot-browser-mcp.startServer",
        "title": "Start MCP Server",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.stopServer",
        "title": "Stop MCP Server",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.restartServer",
        "title": "Restart MCP Server",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.showStatus",
        "title": "Show Server Status",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.openBridgeStatus",
        "title": "Open Bridge Status",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.openHealth",
        "title": "Open Health Endpoint",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.openRestTools",
        "title": "Open REST Tool List",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.openOpenApi",
        "title": "Open OpenAPI Document",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.copyMcpEndpoint",
        "title": "Copy MCP Endpoint",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.copyPowerPlatformEndpoint",
        "title": "Copy Power Platform REST URL",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.forwardDevTunnel",
        "title": "Forward HTTP Port with VS Code",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.setDevTunnelUrl",
        "title": "Set Dev Tunnel URL",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.testEndpoints",
        "title": "Test Local and Dev Tunnel Endpoints",
        "category": "Darbot Browser MCP"
      },
      {
        "command": "darbot-browser-mcp.openSettings",
        "title": "Open Settings",
        "category": "Darbot Browser MCP"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "darbot-browser-mcp.connections",
          "name": "Darbot Browser MCP",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Darbot Browser MCP",
      "properties": {
        "darbot-browser-mcp.serverPath": {
          "type": "string",
          "default": "npx @darbotlabs/darbot-browser-mcp@2.1.4",
          "description": "Path or command used to start the Browser MCP server. Whitespace-separated; the first token is the executable."
        },
        "darbot-browser-mcp.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the Browser MCP server when VS Code starts."
        },
        "darbot-browser-mcp.autoConfigureMCP": {
          "type": "boolean",
          "default": true,
          "description": "When set, the extension offers to enable VS Code's MCP Gallery (chat.mcp.gallery.enabled) the first time it activates."
        },
        "darbot-browser-mcp.transport": {
          "type": "string",
          "enum": [
            "http",
            "stdio"
          ],
          "default": "http",
          "description": "Transport used by the extension. HTTP exposes /mcp and /api/v1 routes for VS Code, Copilot Studio, Power Platform, and Dev Tunnels; stdio preserves process-only MCP behavior."
        },
        "darbot-browser-mcp.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Log level forwarded to the Browser MCP server."
        },
        "darbot-browser-mcp.browser": {
          "type": "string",
          "default": "msedge",
          "enum": [
            "msedge",
            "chrome",
            "firefox",
            "webkit"
          ],
          "description": "Browser channel the MCP server should drive."
        },
        "darbot-browser-mcp.headless": {
          "type": "boolean",
          "default": false,
          "description": "Run the browser in headless mode."
        },
        "darbot-browser-mcp.noSandbox": {
          "type": "boolean",
          "default": true,
          "description": "Disable the Chromium sandbox. Required inside many containers; safe to leave enabled on the desktop."
        },
        "darbot-browser-mcp.http.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host used by the managed Streamable HTTP server. Loopback is sufficient for VS Code Dev Tunnels and avoids exposing the port directly to the LAN."
        },
        "darbot-browser-mcp.http.port": {
          "type": "integer",
          "default": 3000,
          "minimum": 1,
          "maximum": 65535,
          "description": "Local port that exposes /mcp, /api/v1, health, and OpenAPI routes."
        },
        "darbot-browser-mcp.http.startupTimeout": {
          "type": "integer",
          "default": 15000,
          "minimum": 1000,
          "maximum": 120000,
          "description": "Milliseconds to wait for the managed HTTP server's /live endpoint during startup."
        },
        "darbot-browser-mcp.devTunnel.url": {
          "type": "string",
          "default": "",
          "description": "Public VS Code Dev Tunnel base URL. Endpoint suffixes such as /mcp or /api/v1 are normalized automatically by the Set Dev Tunnel URL command."
        },
        "darbot-browser-mcp.devTunnel.promptOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Open VS Code's native Forward a Port flow after the managed HTTP server starts."
        },
        "darbot-browser-mcp.bridgeStatusUrl": {
          "type": "string",
          "default": "http://localhost:9223/health",
          "description": "HTTP endpoint opened by the 'Open Bridge Status' command. Override when running the MCP server on a non-default port."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && node ./scripts/package-vsix.mjs",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^11.8.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "mocha": {
      "diff": "^9.0.0",
      "glob": "^13.0.6",
      "serialize-javascript": "^7.1.0"
    }
  }
}
