<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>DarbotLabs.Browser.MCP</id>
    <version>0.3.0</version>
    <title>🤖 Darbot Browser MCP - Autonomous Browser Companion</title>
    <authors>DarbotLabs</authors>
    <description>🤖 Your Autonomous Browser Companion - 39 AI-driven browser automation tools for Model Context Protocol (MCP) servers (34 accessibility-first + 5 vision-mode). Includes AI-native automation, autonomous crawling with BFS planner and memory system, work profiles, and VS Code GitHub Copilot agent mode integration. Supports Local, Hosted (Docker with MSAL), and Cloud (Azure) deployment modes. See docs/readme_index.md for canonical tool list.</description>
    <releaseNotes>v0.3.0: Added 5 new tools (AI-native automation, autonomous crawling), deployment mode selection (Local/Hosted/Cloud), enhanced VS Code extension with auto-configuration, Docker hosted edition with MSAL auth, Azure deployment templates, and comprehensive tool validation (23/34 core tools tested).</releaseNotes>
    <summary>Autonomous browser MCP server with 34 AI-driven browser tools, AI-native automation, autonomous crawling, work profiles, and multi-deployment support</summary>
    <language>en-US</language>
    <projectUrl>https://github.com/darbotlabs/darbot-browser-mcp</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/darbotlabs/darbot-browser-mcp/main/extension/icons/icon-128.png</iconUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">Apache-2.0</license>
    <copyright>Copyright 2025 DarbotLabs</copyright>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.Extensions.Hosting" version="8.0.0" />
        <dependency id="Microsoft.Extensions.Logging" version="8.0.0" />
        <dependency id="System.Text.Json" version="8.0.0" />
      </group>
    </dependencies>
    <tags>mcp browser autonomous darbot testing web-automation model-context-protocol ai copilot github-copilot vscode agent-mode work-profiles azure docker msal ai-native crawling deployment</tags>
  </metadata>
  <files>
    <file src="dotnet\**\*" target="lib\net8.0" />
    <file src="vscode-extension\**\*" target="tools\vscode-extension" />
    <file src="cli.js" target="tools" />
    <file src="package.json" target="tools" />
    <file src="README.md" target="" />
    <file src="DarbotGuide.md" target="docs" />
    <file src="VSCODE_INSTALLATION.md" target="docs" />
    <file src="LICENSE" target="" />
  </files>
</package>